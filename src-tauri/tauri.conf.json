{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ILA Studio",
  "identifier": "io.github.atahana.ila-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ILA Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "publisher": "Atahan Aggunlu",
    "copyright": "Copyright (C) 2026 Atahan Aggunlu",
    "category": "DeveloperTool",
    "shortDescription": "Capture and analysis GUI for Vivado ILA (Integrated Logic Analyzer) cores",
    "homepage": "https://github.com/AtahanA/ila-studio",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
